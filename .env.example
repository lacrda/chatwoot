# Chatwoot + Railway (minimo)
RAILS_ENV=production
NODE_ENV=production
SECRET_KEY_BASE=gere-um-secret-forte
FRONTEND_URL=https://seu-dominio-publico

# Postgres (pode usar variaveis injetadas pelo Railway via Reference Variables)
POSTGRES_HOST=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Redis (plugin Railway)
REDIS_URL=

# Recomendada para o app Rails funcionar sem mapear manualmente credenciais separadas
DATABASE_URL=
